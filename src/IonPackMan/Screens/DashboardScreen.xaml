<UserControl x:Class="IonPackMan.Screens.DashboardScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IonPackMan.Controls">
    <UserControl.Resources>
        <!-- Path executable ditampilkan sebagai tooltip baris (lebar 808px tidak cukup untuk kolomnya) -->
        <Style x:Key="PathRow" TargetType="DataGridRow" BasedOn="{StaticResource GridRow}">
            <Setter Property="ToolTip" Value="{Binding Path}"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,14">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="↻ Refresh" VerticalAlignment="Top" Click="OnRefreshClick"/>
            <StackPanel>
                <TextBlock Text="System Dashboard" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Current machine status and ION runtime components." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </DockPanel>

        <!-- Backup yang belum selesai (PRD R11): Developer Console terkunci sampai dipulihkan -->
        <c:Notice x:Name="RecoveryBanner" Kind="Error" Visibility="Collapsed" Margin="0,0,0,10">
            <DockPanel>
                <Button x:Name="RestoreButton" DockPanel.Dock="Right" Content="Restore" Style="{StaticResource DangerButton}"
                        Click="OnRestoreClick" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="RecoveryText" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </c:Notice>

        <c:Notice x:Name="ProblemNotice" Kind="Warning" Visibility="Collapsed"/>

        <!-- 4 kartu metrik dalam satu baris -->
        <UniformGrid Columns="4">
            <HeaderedContentControl Style="{StaticResource Card}" Margin="0,0,6,0">
                <StackPanel><TextBlock Text="Machine Name" Style="{StaticResource MutedText}"/><TextBlock x:Name="MachineName" Style="{StaticResource MetricValue}"/>
                    <TextBlock x:Name="EnvironmentText" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
            </HeaderedContentControl>
            <HeaderedContentControl Style="{StaticResource Card}" Margin="3,0">
                <StackPanel><TextBlock Text="Detected Profile" Style="{StaticResource MutedText}"/><TextBlock x:Name="ProfileName" Style="{StaticResource MetricValue}"/>
                    <c:StatusPill x:Name="ProfilePill" Margin="0,4,0,0"/></StackPanel>
            </HeaderedContentControl>
            <HeaderedContentControl Style="{StaticResource Card}" Margin="3,0">
                <StackPanel><TextBlock Text="Windows" Style="{StaticResource MutedText}"/><TextBlock x:Name="WindowsText" Style="{StaticResource MetricValue}" FontSize="13"
                                                                                                       TextWrapping="Wrap" TextTrimming="None"/></StackPanel>
            </HeaderedContentControl>
            <HeaderedContentControl Style="{StaticResource Card}" Margin="6,0,0,0">
                <StackPanel><TextBlock Text="Deployment State" Style="{StaticResource MutedText}"/><c:StatusPill x:Name="DeploymentPill" Margin="0,6,0,0"/></StackPanel>
            </HeaderedContentControl>
        </UniformGrid>

        <!-- ION Applications: tiga nilai mendatar -->
        <HeaderedContentControl Style="{StaticResource Card}" Header="ION Applications" Margin="0,12,0,0">
            <UniformGrid Columns="3">
                <StackPanel Margin="0,0,10,0"><TextBlock Text="Base directory" Style="{StaticResource MutedText}"/><TextBlock x:Name="BaseDirectory" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="Profile config" Style="{StaticResource MutedText}"/><TextBlock x:Name="ProfileConfig" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel><TextBlock Text="Last deployment" Style="{StaticResource MutedText}"/><TextBlock x:Name="LastDeployment" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel>
            </UniformGrid>
        </HeaderedContentControl>

        <HeaderedContentControl Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <Grid DockPanel.Dock="Right" Width="180">
                        <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" ToolTip="Search services and processes"/>
                        <!-- Petunjuk "Search…" hilang begitu ada teks -->
                        <TextBlock Text="Search…" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource Brush.Muted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="ION Services" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Windows Services from machine.ini [SERVICE] and the active profile" Style="{StaticResource MutedText}" FontSize="11"/>
                    </StackPanel>
                </DockPanel>
                <DataGrid x:Name="ServicesGrid" MaxHeight="220" RowStyle="{StaticResource PathRow}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Service" Width="1.3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel><TextBlock Text="{Binding Service}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="1.2*"/>
                        <DataGridTemplateColumn Header="Status" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><c:StatusPill Text="{Binding Status}" Kind="{Binding Kind}"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Startup Type" Binding="{Binding StartType}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <c:EmptyState x:Name="ServicesEmpty" Icon="⚙" Title="No services to show" Visibility="Collapsed"
                              Message="No Windows Service is declared in machine.ini or by the active profile, or found under the ION base directory."/>
            </StackPanel>
        </HeaderedContentControl>

        <HeaderedContentControl Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Related Processes" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Processes are separate from Windows Service status." Style="{StaticResource MutedText}" FontSize="11"/>
                </StackPanel>
                <DataGrid x:Name="ProcessesGrid" MaxHeight="220" RowStyle="{StaticResource PathRow}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="1.3*"/>
                        <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="1.2*"/>
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="0.6*"/>
                        <DataGridTemplateColumn Header="Status" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><c:StatusPill Text="{Binding Status}" Kind="{Binding Kind}"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="0.8*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </HeaderedContentControl>
    </StackPanel>
</UserControl>
