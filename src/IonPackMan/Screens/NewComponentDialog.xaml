<Window x:Class="IonPackMan.Screens.NewComponentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:IonPackMan.Controls"
        Style="{StaticResource {x:Type Window}}"
        Title="New component" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!-- Mendaftarkan component baru di catalog.ini; release-nya dibuat setelah ini di form Components. -->
    <StackPanel Margin="20,14,20,14">
        <TextBlock Text="Add a component to the catalog" FontSize="14" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,10" TextWrapping="Wrap"
                   Text="After adding it, create its first release (target directory and service) and add it to a profile."/>
        <TextBlock Text="Component id" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="IdBox" AutomationProperties.Name="Component id" ToolTip="Lowercase letters and digits, words separated by '-', e.g. offline-auth"/>
        <TextBlock Text="Display name" FontWeight="SemiBold" Margin="0,10,0,4"/>
        <TextBox x:Name="NameBox" AutomationProperties.Name="Display name"/>
        <c:Notice x:Name="ErrorNotice" Kind="Error" Visibility="Collapsed" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="AddButton" Content="Add" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnAddClick"/>
        </StackPanel>
    </StackPanel>
</Window>
