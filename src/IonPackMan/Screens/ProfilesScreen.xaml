<UserControl x:Class="IonPackMan.Screens.ProfilesScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IonPackMan.Controls">
    <!-- Layar Profiles (T12, UI/UX 4.3). Tampilan saja; logika ada di Profile*, ConfigResolver, ProfileStore. -->
    <UserControl.Resources>
        <!-- Tab bergaya prototype: garis bawah biru pada tab aktif -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Background="Transparent"/>
                            </Border>
                            <ContentPresenter Margin="0,14,0,0" ContentSource="SelectedContent"/>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="13,9" Margin="0,0,4,-1" Background="Transparent" Cursor="Hand">
                            <ContentPresenter x:Name="Head" ContentSource="Header" TextElement.Foreground="{StaticResource Brush.Muted}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Blue}"/>
                                <Setter TargetName="Head" Property="TextElement.Foreground" Value="{StaticResource Brush.Blue}"/>
                                <Setter TargetName="Head" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Page head -->
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="ImportButton" Content="Import INI…" Margin="0,0,6,0" Click="OnImport"/>
                <Button x:Name="ExportButton" Content="Export INI…" Margin="0,0,6,0" Click="OnExport"/>
                <Button x:Name="ValidateButton" Content="Validate" Margin="0,0,6,0" Click="OnValidate"/>
                <Button x:Name="SaveButton" Content="Save Profile" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Click="OnSave"/>
                <Button x:Name="NewButton" Content="New profile" Click="OnNew"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Profiles" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Compose component versions and features for a machine." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </DockPanel>

        <c:Notice x:Name="Banner" Visibility="Collapsed" Margin="0,0,0,12"/>

        <!-- Katalog profile -->
        <HeaderedContentControl Style="{StaticResource Card}" Header="Profile catalog" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Search profiles" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SearchBox" TextChanged="OnCatalogQueryChanged" ToolTip="Search by profile ID, name or version"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Filter" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="FilterBox" SelectedIndex="0" SelectionChanged="OnCatalogQueryChanged">
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="With components"/>
                            <ComboBoxItem Content="Empty"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <c:Notice x:Name="CatalogNotice" Kind="Error" Visibility="Collapsed" Margin="0,0,0,10"/>
                <Border BorderBrush="{StaticResource Brush.RowLine}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <DataGrid x:Name="CatalogGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Profile" Binding="{Binding Title}" Width="2*"/>
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="0.8*"/>
                                <DataGridTextColumn Header="Components" Binding="{Binding ComponentsText}" Width="0.9*"/>
                                <DataGridTemplateColumn Header="Valid?" Width="1.1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <c:StatusPill Text="{Binding StatusText}" Kind="{Binding StatusKind}" HorizontalAlignment="Left"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Switch" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Switch" Tag="{Binding Id}" IsEnabled="{Binding CanSwitch}" Style="{StaticResource RowButton}" Click="OnSwitchClick"
                                                    ToolTip="Deploy every component of this profile and make it the active profile"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Open" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Open" Tag="{Binding Id}" IsEnabled="{Binding CanOpen}" Style="{StaticResource RowButton}" Click="OnOpenClick"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <c:EmptyState x:Name="CatalogEmpty" Icon="◷" Title="No profiles" Message="No profile matches this search." Visibility="Collapsed" Margin="0,40"/>
                    </Grid>
                </Border>
                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="PrevButton" Content="‹ Prev" Margin="0,0,6,0" Click="OnPrevPage"/>
                        <Button x:Name="NextButton" Content="Next ›" Click="OnNextPage"/>
                    </StackPanel>
                    <TextBlock x:Name="PageText" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </HeaderedContentControl>

        <!-- Definisi profile -->
        <HeaderedContentControl Style="{StaticResource Card}">
            <HeaderedContentControl.Header>
                <DockPanel>
                    <c:StatusPill x:Name="ValidPill" DockPanel.Dock="Right" Text="Valid" Kind="Success" VerticalAlignment="Center"/>
                    <TextBlock Text="Profile definition"/>
                </DockPanel>
            </HeaderedContentControl.Header>
            <TabControl x:Name="Tabs">
                <TabItem Header="Components">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Profile ID" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="IdBox" TextChanged="OnFormChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Display name" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="NameBox" TextChanged="OnFormChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Profile version" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="VersionBox" TextChanged="OnFormChanged"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Add component" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AddComponentBox" DisplayMemberPath="Label" SelectionChanged="OnAddComponentChanged"/>
                            <ComboBox x:Name="AddVersionBox" Grid.Column="2" SelectionChanged="OnAddVersionChanged"/>
                            <Button x:Name="AddButton" Grid.Column="4" Content="＋ Add" Click="OnAdd"/>
                        </Grid>
                        <TextBlock x:Name="AddHint" Style="{StaticResource MutedText}" Margin="0,0,0,10" Visibility="Collapsed"
                                   Text="No saved versions for this component. Save a release in Components first."/>

                        <!-- Daftar component: header kolom di sini, baris dibuat di code-behind -->
                        <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" CornerRadius="8" Margin="0,6,0,0">
                            <StackPanel>
                                <Border Background="{StaticResource Brush.TableHeader}" CornerRadius="8,8,0,0" Padding="11,0" Height="32"
                                        BorderBrush="{StaticResource Brush.RowLine}" BorderThickness="0,0,0,1">
                                    <Grid TextElement.FontSize="12" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource Brush.Muted}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="76"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Component" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Version" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="DependsOn (comma-separated)" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="ComponentRows"/>
                                <TextBlock x:Name="NoComponents" Text="No components yet. Pick one above and press Add."
                                           Style="{StaticResource MutedText}" Margin="11,12" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Registry &amp; INI">
                    <StackPanel>
                        <CheckBox x:Name="WebUiCheck" Content="Enable WIND WebUI" Checked="OnFeatureChanged" Unchecked="OnFeatureChanged"/>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="JnlLogCheck" Content="Enable JNLLog" Checked="OnFeatureChanged" Unchecked="OnFeatureChanged"/>
                            <TextBlock x:Name="JnlLogHint" Text="Requires WIND WebUI" Style="{StaticResource MutedText}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </StackPanel>
                        <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" CornerRadius="8" Margin="0,12,0,0" ClipToBounds="True">
                            <StackPanel>
                                <DataGrid x:Name="ConfigGrid" MaxHeight="300">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="76"/>
                                        <DataGridTemplateColumn Header="Target" Width="2.2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Target}" ToolTip="{Binding Target}" TextWrapping="Wrap" FontSize="11" Margin="0,5"
                                                               Foreground="{Binding TextBrush}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Entry" Width="1.2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Entry}" ToolTip="{Binding Entry}" TextWrapping="Wrap" Margin="0,5"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="52"/>
                                        <DataGridTemplateColumn Header="State" Width="104">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <c:StatusPill Text="{Binding StateText}" Kind="{Binding StateKind}" HorizontalAlignment="Left"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Allow-list" Width="76">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AllowSymbol}" ToolTip="{Binding AllowTip}" FontSize="15" FontWeight="Bold"
                                                               Foreground="{Binding AllowBrush}" HorizontalAlignment="Left"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="NoConfig" Text="No Registry or INI entries are defined. Add them to Config\config-entries.ini (machine-wide) or to this profile's file." Style="{StaticResource MutedText}"
                                           Margin="11,12" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Entries come from the machine-wide Config\config-entries.ini plus any in the profile file. Only features can be toggled here; entries outside the allow-list (✖) make the profile invalid."/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="INI preview">
                    <StackPanel>
                        <TextBox x:Name="PreviewBox" Style="{StaticResource CodePreview}" Height="300"/>
                        <TextBlock x:Name="PreviewPath" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </HeaderedContentControl>
    </StackPanel>
</UserControl>
