<UserControl x:Class="IonPackMan.Screens.HistoryScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IonPackMan.Controls">
    <!-- Layar History (UI/UX Spec §4.5, R12): tabel + panel detail di bawah tabel. Read-only: tidak ada ubah/hapus. -->
    <UserControl.Resources>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="16">
        <DockPanel Margin="0,0,0,16">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="↻ Refresh" VerticalAlignment="Top"
                    AutomationProperties.Name="Refresh history" Click="OnRefreshClick"/>
            <StackPanel>
                <TextBlock Text="Deployment History" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Every execution on this machine, newest first. Entries cannot be edited." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </DockPanel>

        <!-- File history yang rusak: halaman tetap terbuka, file lain tetap tampil (§5) -->
        <c:Notice x:Name="ProblemsNotice" Kind="Warning" Visibility="Collapsed">
            <TextBlock x:Name="ProblemsText"/>
        </c:Notice>

        <HeaderedContentControl Style="{StaticResource Card}" Header="Deployments">
            <StackPanel>
                <DockPanel x:Name="SearchRow" Margin="0,0,0,10">
                    <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    <Grid Width="280" HorizontalAlignment="Left">
                        <TextBox x:Name="SearchBox" ToolTip="Search time, component, build, outcome, operator or profile"
                                 AutomationProperties.Name="Search history" TextChanged="OnSearchChanged"/>
                        <TextBlock x:Name="SearchHint" Text="Search deployments…" Style="{StaticResource MutedText}"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"/>
                    </Grid>
                </DockPanel>

                <DataGrid x:Name="Table" SelectionChanged="OnRowSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="1.3*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="1.2*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Build" Binding="{Binding Build}" Width="1.2*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Header="Outcome" Width="1.6*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <c:StatusPill Text="{Binding OutcomeText}" Kind="{Binding Kind}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <c:EmptyState x:Name="Empty" Title="No deployments yet" Message="History will appear after the first execution."/>

                <DockPanel x:Name="PagerRow" Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="PrevButton" Content="‹ Previous" Margin="0,0,8,0" Click="OnPrevClick"/>
                        <Button x:Name="NextButton" Content="Next ›" Click="OnNextClick"/>
                    </StackPanel>
                    <TextBlock x:Name="PageText" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </HeaderedContentControl>

        <!-- Detail di bawah tabel (bukan di kanan: lebar 810px tidak cukup) -->
        <HeaderedContentControl x:Name="Detail" Style="{StaticResource Card}" Header="Execution details" Margin="0,12,0,0"
                                Visibility="Collapsed">
            <StackPanel>
                <UniformGrid Columns="2">
                    <StackPanel x:Name="LeftColumn" Margin="0,0,12,0"/>
                    <StackPanel x:Name="RightColumn" Margin="12,0,0,0"/>
                </UniformGrid>
                <StackPanel x:Name="WideRows"/>

                <c:Notice x:Name="ErrorNotice" Kind="Error" Margin="0,12,0,0" Visibility="Collapsed">
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="ErrorText" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </c:Notice>

                <StackPanel x:Name="BackupRow" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="OpenBackupButton" Content="Open backup folder" Click="OnOpenBackupClick"/>
                    <TextBlock x:Name="BackupMissingText" Text="Backup folder was not found on this machine." Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </HeaderedContentControl>
    </StackPanel>
</UserControl>
