<Window x:Class="IonPackMan.Screens.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Executing…" Width="480" Height="320"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Closing="OnClosing">
    <!-- Dialog progres modal (T28, UI/UX 4.4 aturan 5). Tidak bisa ditutup saat berjalan; Close muncul setelah selesai. -->
    <Grid Margin="20,12,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SubText" Style="{StaticResource MutedText}" Margin="0,2,0,0"
                       Text="Do not close ION PackMan until this finishes."/>
        </StackPanel>

        <StackPanel x:Name="StepsPanel" Grid.Row="1" Margin="0,8,0,0"/>

        <DockPanel Grid.Row="2" Margin="0,6,0,0" MinHeight="32">
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" Style="{StaticResource PrimaryButton}"
                    Margin="12,0,0,0" VerticalAlignment="Bottom" IsDefault="True" Visibility="Collapsed" Click="OnCloseClick"/>
            <TextBlock x:Name="SummaryText" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       MaxHeight="48" VerticalAlignment="Bottom"/>
        </DockPanel>
    </Grid>
</Window>
