<UserControl x:Class="IonPackMan.Resources.ControlGallery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IonPackMan.Controls">
    <!-- Contoh semua kontrol bersama (T02). Dipakai test render dan sebagai acuan junior saat membuat layar baru. -->
    <StackPanel Margin="16">
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="↻ Refresh" Margin="0,0,8,0"/>
                <Button Content="Save Component" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="System Dashboard" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Current machine status and ION runtime components." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </DockPanel>

        <c:Notice Kind="Error" x:Name="RecoveryBanner">
            <TextBlock><Run FontWeight="Bold" Text="Last execution was interrupted."/><Run Text=" Restore before continuing."/></TextBlock>
        </c:Notice>
        <c:Notice Kind="Warning"><TextBlock Text="Target directory is not inside an allowed base directory."/></c:Notice>
        <c:Notice Kind="Success"><TextBlock Text="Component release saved."/></c:Notice>
        <c:Notice Kind="Info"><TextBlock Text="Executes on this machine. A backup is created first."/></c:Notice>

        <UniformGrid Columns="2" Margin="0,8,0,0">
            <HeaderedContentControl Style="{StaticResource Card}" Header="Component release" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Release version" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="2.1.0" Margin="0,0,0,10"/>
                    <TextBlock Text="Component" Style="{StaticResource FieldLabel}"/>
                    <ComboBox SelectedIndex="0" Margin="0,0,0,10">
                        <ComboBoxItem Content="WIND (wind)"/>
                        <ComboBoxItem Content="ION Middleware (ion-middleware)"/>
                    </ComboBox>
                    <TextBlock Text="Target directory (read-only)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="D:\APCONTAINER\WIND" IsReadOnly="True" Margin="0,0,0,10"/>
                    <CheckBox Content="Deploy files"/>
                    <CheckBox Content="Apply config" IsChecked="True"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Preview plan" Margin="0,0,8,0"/>
                        <Button Content="Execute" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Content="Restore" Style="{StaticResource DangerButton}" Margin="0,0,8,0"/>
                        <Button Content="Disabled" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource Card}" Header="ION Applications" Margin="6,0,0,0">
                <StackPanel>
                    <HeaderedContentControl Style="{StaticResource KeyValueRow}" Header="Base directory" Content="D:\ION"/>
                    <HeaderedContentControl Style="{StaticResource KeyValueRow}" Header="Profile config" Content="Valid"/>
                    <HeaderedContentControl Style="{StaticResource KeyValueRow}" Header="Last deployment">
                        <c:StatusPill Text="Succeeded" Kind="Success"/>
                    </HeaderedContentControl>
                    <WrapPanel Margin="0,12,0,0">
                        <c:StatusPill Text="Running" Kind="Success" Margin="0,0,6,6"/>
                        <c:StatusPill Text="Stopped" Kind="Neutral" Margin="0,0,6,6"/>
                        <c:StatusPill Text="Sample profile" Kind="Warning" Margin="0,0,6,6"/>
                        <c:StatusPill Text="FailedRestored" Kind="Error" Margin="0,0,6,6"/>
                        <c:StatusPill Text="RestoredAfterCrash" Kind="Info" Margin="0,0,6,6"/>
                    </WrapPanel>
                </StackPanel>
            </HeaderedContentControl>
        </UniformGrid>

        <HeaderedContentControl Style="{StaticResource Card}" Header="ION Services" Margin="0,12,0,0">
            <DataGrid x:Name="Services" Height="106">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="1.2*"/>
                    <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="1.2*"/>
                    <DataGridTemplateColumn Header="Status" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <c:StatusPill Text="{Binding Status}" Kind="{Binding Kind}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Startup Type" Binding="{Binding Startup}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </HeaderedContentControl>

        <HeaderedContentControl Style="{StaticResource Card}" Header="INI preview" Margin="0,12,0,0">
            <TextBox Style="{StaticResource CodePreview}" Height="96"
                     Text="[Component]&#13;&#10;Id=wind&#13;&#10;ReleaseVersion=2.1.0&#13;&#10;&#13;&#10;[Installation]&#13;&#10;TargetDirectory=D:\APCONTAINER\WIND"/>
        </HeaderedContentControl>

        <HeaderedContentControl Style="{StaticResource Card}" Margin="0,12,0,0">
            <c:EmptyState Title="No deployments yet" Message="History will appear after the first execution."/>
        </HeaderedContentControl>
    </StackPanel>
</UserControl>
