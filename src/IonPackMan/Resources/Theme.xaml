<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:IonPackMan.Controls">

    <!-- ============ Token (UI/UX Spec §3) — satu-satunya tempat warna & ukuran ============ -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#F5F7FB"/>
    <SolidColorBrush x:Key="Brush.Panel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Line" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Brush.RowLine" Color="#EDF0F5"/>
    <SolidColorBrush x:Key="Brush.TableHeader" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#172033"/>
    <SolidColorBrush x:Key="Brush.TextSoft" Color="#334155"/>
    <SolidColorBrush x:Key="Brush.Muted" Color="#64748B"/>
    <SolidColorBrush x:Key="Brush.Blue" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.BlueSoft" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="Brush.Focus" Color="#BFDBFE"/>
    <SolidColorBrush x:Key="Brush.Red" Color="#B91C1C"/>
    <SolidColorBrush x:Key="Brush.Online" Color="#22C55E"/>
    <SolidColorBrush x:Key="Brush.Pending" Color="#F59E0B"/>
    <SolidColorBrush x:Key="Brush.Code.Bg" Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.Code.Text" Color="#DBEAFE"/>

    <!-- Warna status: latar lembut + teks gelap -->
    <SolidColorBrush x:Key="Brush.Success.Bg" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="Brush.Success.Fg" Color="#166534"/>
    <SolidColorBrush x:Key="Brush.Success.Border" Color="#BBF7D0"/>
    <SolidColorBrush x:Key="Brush.Warning.Bg" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="Brush.Warning.Fg" Color="#92400E"/>
    <SolidColorBrush x:Key="Brush.Warning.Border" Color="#FDE68A"/>
    <SolidColorBrush x:Key="Brush.Error.Bg" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="Brush.Error.Fg" Color="#991B1B"/>
    <SolidColorBrush x:Key="Brush.Error.Border" Color="#FECACA"/>
    <SolidColorBrush x:Key="Brush.Info.Bg" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="Brush.Info.Fg" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Brush.Info.Border" Color="#BFDBFE"/>
    <SolidColorBrush x:Key="Brush.Neutral.Bg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Brush.Neutral.Fg" Color="#475569"/>
    <SolidColorBrush x:Key="Brush.Neutral.Border" Color="#E2E8F0"/>

    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Size.Control">32</system:Double>

    <!-- ============ Dasar ============ -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{StaticResource Brush.Bg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    </Style>

    <!-- Teks halaman -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSoft}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- ============ Tombol: Button (outline), PrimaryButton (biru), DangerButton (merah) ============ -->
    <Style TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Size.Control}"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSoft}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <!-- Lapisan gelap tipis saat hover; berlaku untuk semua warna tombol -->
                        <Border x:Name="Hover" Background="#0F172A" Opacity="0" IsHitTestVisible="False"
                                CornerRadius="{StaticResource Radius.Control}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.06"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Blue}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource Brush.Blue}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Blue}"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource Brush.Red}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Red}"/>
    </Style>

    <!-- ============ Menu sidebar: RadioButton dalam satu group (yang aktif biru muda) ============ -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSoft}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="9" Padding="10,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.TableHeader}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.BlueSoft}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Blue}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Focus}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Input ============ -->
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}">
                        <!-- Padding diterapkan TextBox sendiri ke PART_ContentHost; jangan diberi Margin lagi -->
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Blue}"/>
                        </Trigger>
                        <!-- Tanpa TargetName agar style turunan (CodePreview) tetap bisa menimpa latar -->
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.TableHeader}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Pratinjau INI read-only (gelap, monospace) -->
    <Style x:Key="CodePreview" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Code.Text}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Code.Bg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Code.Bg}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Style.Triggers>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Code.Bg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBox datar (tanpa gradasi bawaan): kotak putih, panah kecil, daftar dengan sorotan biru muda -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.BlueSoft}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.BlueSoft}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Blue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}"/>
        <Setter Property="Padding" Value="10,0,30,0"/>
        <Setter Property="Background" Value="{StaticResource Brush.Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="1" CornerRadius="{StaticResource Radius.Control}">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                              Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource Brush.Muted}" StrokeThickness="1.5"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Blue}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.InputBorder}"
                                    BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Margin="0,4,0,8"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="#0F172A"/>
                                </Border.Effect>
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>

    <!-- ============ Card: <HeaderedContentControl Style="{StaticResource Card}" Header="Judul"> ============ -->
    <Style x:Key="Card" TargetType="HeaderedContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Line}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="14">
                        <DockPanel>
                            <ContentPresenter x:Name="Title" DockPanel.Dock="Top" ContentSource="Header" Margin="0,0,0,12"
                                              TextElement.FontSize="14" TextElement.FontWeight="SemiBold"/>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ KeyValueRow: Header = label abu-abu, isi = nilai ============ -->
    <Style x:Key="KeyValueRow" TargetType="HeaderedContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border BorderBrush="{StaticResource Brush.RowLine}" BorderThickness="0,0,0,1" Padding="0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="{StaticResource Brush.Muted}"
                                              TextElement.FontSize="12" VerticalAlignment="Top"/>
                            <ContentPresenter Grid.Column="1" TextElement.FontSize="12" TextElement.FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ StatusPill ============ -->
    <Style TargetType="{x:Type c:StatusPill}">
        <Setter Property="Background" Value="{StaticResource Brush.Neutral.Bg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Neutral.Fg}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:StatusPill}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,3">
                        <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}"
                                   FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Kind" Value="Success">
                <Setter Property="Background" Value="{StaticResource Brush.Success.Bg}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Success.Fg}"/>
            </Trigger>
            <Trigger Property="Kind" Value="Warning">
                <Setter Property="Background" Value="{StaticResource Brush.Warning.Bg}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Warning.Fg}"/>
            </Trigger>
            <Trigger Property="Kind" Value="Error">
                <Setter Property="Background" Value="{StaticResource Brush.Error.Bg}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Error.Fg}"/>
            </Trigger>
            <Trigger Property="Kind" Value="Info">
                <Setter Property="Background" Value="{StaticResource Brush.Info.Bg}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Info.Fg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ Notice (Warning default, Success, Error, Info, Neutral) ============ -->
    <Style TargetType="{x:Type c:Notice}">
        <Setter Property="Background" Value="{StaticResource Brush.Warning.Bg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning.Border}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Warning.Fg}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,6"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:Notice}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="12,10">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Kind" Value="Success">
                <Setter Property="Background" Value="{StaticResource Brush.Success.Bg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Success.Border}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Success.Fg}"/>
            </Trigger>
            <Trigger Property="Kind" Value="Error">
                <Setter Property="Background" Value="{StaticResource Brush.Error.Bg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Error.Border}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Error.Fg}"/>
            </Trigger>
            <Trigger Property="Kind" Value="Info">
                <Setter Property="Background" Value="{StaticResource Brush.Info.Bg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Info.Border}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Info.Fg}"/>
            </Trigger>
            <Trigger Property="Kind" Value="Neutral">
                <Setter Property="Background" Value="{StaticResource Brush.Neutral.Bg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Neutral.Border}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Neutral.Fg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ EmptyState ============ -->
    <Style TargetType="{x:Type c:EmptyState}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:EmptyState}">
                    <StackPanel HorizontalAlignment="Center" Margin="0,28">
                        <TextBlock Text="{TemplateBinding Icon}" FontSize="28" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,8"/>
                        <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brush.Muted}"/>
                        <TextBlock Text="{TemplateBinding Message}" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"
                                   Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Toast ============ -->
    <Style TargetType="{x:Type c:Toast}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="0,0,20,20"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:Toast}">
                    <Border Background="#172033" CornerRadius="9" Padding="16,12" MaxWidth="360">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.25" Color="#0F172A"/>
                        </Border.Effect>
                        <TextBlock Text="{TemplateBinding Message}" Foreground="White" TextWrapping="Wrap"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Tabel (DataGrid read-only seperti prototype) ============ -->
    <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Brush.TableHeader}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.RowLine}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="GridCell" TargetType="DataGridCell">
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.RowLine}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="ValidationErrorTemplate" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.TableHeader}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.BlueSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="Background" Value="{StaticResource Brush.Panel}"/>
        <Setter Property="RowBackground" Value="{StaticResource Brush.Panel}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeader}"/>
        <Setter Property="CellStyle" Value="{StaticResource GridCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource GridRow}"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
</ResourceDictionary>
