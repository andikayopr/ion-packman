<Window x:Class="IonPackMan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:IonPackMan.Controls"
        Title="ION PackMan"
        MinWidth="800" MinHeight="540"
        WindowState="Maximized"
        SizeChanged="OnSizeChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="184"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: logo, menu, versi -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,12">
                <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" FontSize="11" Margin="10,8,0,0"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,20">
                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource Brush.Info.Bg}">
                        <TextBlock Text="ION" FontWeight="ExtraBold" FontSize="13" Foreground="{StaticResource Brush.Blue}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel x:Name="BrandText" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ION PackMan" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="Offline Deployment" Style="{StaticResource MutedText}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="Nav"/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Topbar: breadcrumb kiri, status mesin kanan -->
            <Border Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1" Padding="16,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,1,8,0" Fill="{StaticResource Brush.Muted}"/>
                        <TextBlock x:Name="MachineText" Text="Reading machine.ini…" FontSize="12" Foreground="{StaticResource Brush.TextSoft}"/>
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Brush.Muted}">
                        <Run Text="ION PackMan"/><Run Text=" / "/><Run x:Name="CrumbText" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold"/>
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- Area konten: hanya bagian ini yang scroll (vertikal) -->
            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="ScreenHost" Margin="16" IsTabStop="False"/>
            </ScrollViewer>
        </Grid>

        <c:Toast x:Name="ToastBox" Grid.Column="1"/>
    </Grid>
</Window>
